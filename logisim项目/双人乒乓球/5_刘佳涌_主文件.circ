    <comp lib="7" loc="(1050,315)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="与挡板是否相撞"/>
    </comp>
    <comp lib="7" loc="(1090,825)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="VYN、VY、FLIPY"/>
    </comp>
    <comp lib="7" loc="(1300,1020)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="后面会令VY=VYN"/>
    </comp>
    <comp lib="7" loc="(1305,990)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="开始时寄存器会令VY为0"/>
    </comp>
    <comp lib="7" loc="(1320,825)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="VYN用于存储当前速度方向"/>
    </comp>
    <comp lib="7" loc="(1325,850)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="在有效碰撞上下边界后反向"/>
    </comp>
    <comp lib="7" loc="(1335,365)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="相撞时FLIPX为1"/>
    </comp>
    <comp lib="7" loc="(1410,1435)" name="Text">
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="球的初始位置不需要额外电路确认——当 rst_global 复位信号有效时，BX/BY 寄存器会被直接置为 Logisim 寄存器属性里设置的&quot;reset value&quot;固定值（通常就是场地中心，比如 BX=4、BY=中间行），一松开复位球就从那里开始移动。"/>
    </comp>
    <comp lib="7" loc="(1505,305)" name="Text">
      <a name="color" val="#ff0100"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="FLIPX"/>
    </comp>
    <comp lib="7" loc="(160,1030)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="text" val="NVX、NVY、NLOCK"/>
    </comp>
    <comp lib="7" loc="(1630,1155)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="同上"/>
    </comp>
    <comp lib="7" loc="(1645,535)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="右边不相撞则missr"/>
    </comp>
    <comp lib="7" loc="(1650,220)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="左边不相撞则missl"/>
    </comp>
    <comp lib="7" loc="(1745,850)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="根据当前速度方向，DY会在001和111之间变化"/>
    </comp>
    <comp lib="7" loc="(2000,1000)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="BXN、BXD、BX、DX"/>
    </comp>
    <comp lib="7" loc="(2095,720)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="DY、BYD、BY"/>
    </comp>
    <comp lib="7" loc="(2110,885)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="每一时刻存储当前坐标，并与前面的加法器形成正反馈现象"/>
    </comp>
    <comp lib="7" loc="(2120,340)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="VXN"/>
    </comp>
    <comp lib="7" loc="(2185,500)" name="Text">
      <a name="color" val="#ff0d00"/>
      <a name="font" val="SansSerif bold 24"/>
      <a name="text" val="VX、VXF"/>
    </comp>
    <comp lib="7" loc="(2195,1230)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="将变化后的BXN存进BX"/>
    </comp>
    <comp lib="7" loc="(220,70)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="小球碰撞模块"/>
    </comp>
    <comp lib="7" loc="(2205,575)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="与挡板相撞时（FLIPX=1），NVX即VX取反，x方向速度相当于反向"/>
    </comp>
    <comp lib="7" loc="(2260,610)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="最关键的是VX=0并不代表没有速度，而是与VX=1时的速度等大反向，这是位宽为1只有0与1的速度设计的精髓，小球不会停止"/>
    </comp>
    <comp lib="7" loc="(2265,305)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="miss时，若右边miss，VXN为0，否则为1；未miss时，VXN始终等于VXF"/>
    </comp>
    <comp lib="7" loc="(2265,535)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="初始时，寄存器和多路选择器会令VX、VXF为0，由于上面那个VXN始终等于VXF，所以VXN初始也为0"/>
    </comp>
    <comp lib="7" loc="(250,730)" name="Text">
      <a name="color" val="#ff3900"/>
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="常量"/>
    </comp>
    <comp lib="7" loc="(2640,855)" name="Text">
      <a name="color" val="#00b311"/>
      <a name="font" val="SansSerif bold 30"/>
      <a name="text" val="OUTPUT2"/>
    </comp>
    <comp lib="7" loc="(2645,765)" name="Text">
      <a name="color" val="#00940e"/>
      <a name="font" val="SansSerif bold 30"/>
      <a name="text" val="OUTPUT1"/>
    </comp>
    <comp lib="7" loc="(2855,1060)" name="Text">
      <a name="color" val="#0b7810"/>
      <a name="font" val="SansSerif bold 30"/>
      <a name="text" val="OUTPUT3"/>
    </comp>
    <comp lib="7" loc="(357,519)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="YL1为左挡板y轴位置+1"/>
    </comp>
    <comp lib="7" loc="(358,547)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="即挡板向下延伸了一格"/>
    </comp>
    <comp lib="7" loc="(50,315)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="挡板坐标"/>
    </comp>
    <comp lib="7" loc="(560,860)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="这里判断球是否触及上下边界"/>
    </comp>
    <comp lib="7" loc="(595,565)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="判断球是否与挡板同y轴"/>
    </comp>
    <comp lib="7" loc="(780,760)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="NVY与VY一个为1另一个为0"/>
    </comp>
    <comp lib="7" loc="(815,125)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="判断球是否位于左边界"/>
    </comp>
    <comp lib="7" loc="(825,895)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="与门判断是为了只在球y轴速度&quot;正撞向墙&quot;时翻转，离开墙时绝不翻转"/>
    </comp>
    <comp lib="7" loc="(835,260)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="如果与左挡板y轴相同"/>
    </comp>
    <comp lib="7" loc="(845,395)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="判断球是否位于右边界"/>
    </comp>
    <comp lib="7" loc="(850,550)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="如果与右挡板y轴相同"/>
    </comp>
