    </comp>
    <comp lib="7" loc="(1600,315)" name="Text">
      <a name="text" val="yl和yr，即左右高度初始化均为0"/>
    </comp>
    <comp lib="7" loc="(395,400)" name="Text">
      <a name="text" val="先判断是否输入，输入传递常量7，未输入传递常量0"/>
    </comp>
    <comp lib="7" loc="(645,25)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="挡板按键控制模块"/>
    </comp>
    <comp lib="7" loc="(695,325)" name="Text">
      <a name="text" val="传递来的值可能有0、1、7"/>
    </comp>
    <comp lib="7" loc="(700,345)" name="Text">
      <a name="text" val="0代表没有操作"/>
    </comp>
    <comp lib="7" loc="(700,365)" name="Text">
      <a name="text" val="1代表应该下降"/>
    </comp>
    <comp lib="7" loc="(700,380)" name="Text">
      <a name="text" val="7代表应该上升"/>
    </comp>
    <comp lib="7" loc="(700,400)" name="Text">
      <a name="text" val="利用加法器特性进行坐标计算"/>
    </comp>
    <comp lib="7" loc="(930,335)" name="Text">
      <a name="text" val="这导致到达不了7，但挡板宽度为2"/>
    </comp>
    <comp lib="7" loc="(935,355)" name="Text">
      <a name="text" val="且向下延伸一格，所以这个问题不是问题"/>
    </comp>
    <comp lib="7" loc="(945,115)" name="Text">
      <a name="text" val="这里的7是二相性的，原先可能为0或7，所以需要剔除"/>
    </comp>
    <comp lib="7" loc="(945,65)" name="Text">
      <a name="text" val="当y为0时上升，加法器+3位宽特性会将nxyl最终变为7"/>
    </comp>
    <comp lib="7" loc="(945,90)" name="Text">
      <a name="text" val="当y为6时下降，加法器+3位宽特性会将nxyl最终变为7"/>
    </comp>
